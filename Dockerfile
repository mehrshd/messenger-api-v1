# مرحله اول: انتخاب بیس ایمیج (Base Image)
# ما از Node.js نسخه 18 استفاده می‌کنیم. می‌تونی نسخه دقیق‌تری که با پروژه‌ات سازگاره رو انتخاب کنی.
FROM node:22-alpine

# مرحله دوم: تنظیم دایرکتوری کاری در داخل کانتینر
# دستور WORKDIR مسیری رو مشخص می‌کنه که دستورات بعدی تو اونجا اجرا می‌شن.
WORKDIR /server

# مرحله سوم: کپی کردن فایل‌های package.json و package-lock.json
# این کار باعث می‌شه که وابستگی‌ها (dependencies) به صورت جداگانه نصب بشن که برای کش کردن (caching) خیلی مفیده.
COPY package*.json ./

# مرحله چهارم: نصب کردن وابستگی‌های پروژه
# دستور npm install وابستگی‌هایی که تو package.json لیست شدن رو نصب می‌کنه.
RUN npm install

# مرحله پنجم: کپی کردن بقیه فایل‌های پروژه به داخل کانتینر
# پوشه src و بقیه فایل‌های لازم رو به دایرکتوری کاری که تعریف کردیم کپی می‌کنیم.
COPY . .

# مرحله ششم: مشخص کردن پورتی که اپلیکیشن روی اون اجرا می‌شه
# این فقط یه راهنما برای Docker هست و پورت رو واقعاً باز نمی‌کنه.
EXPOSE 3000

# مرحله هفتم: دستور اجرای اپلیکیشن
# این دستور وقتی کانتینر اجرا می‌شه، سرور Node.js شما رو راه می‌ندازه.
CMD ["node", "server.js"]
